{
  "name": "mortar-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web",
    "functions"
  ],
  "scripts": {
    "emulators": "firebase emulators:start",
    "emulators:export": "firebase emulators:export ./emulator-data",
    "emulators:import": "firebase emulators:start --import=./emulator-data",
    "deploy:stage": "firebase deploy --project mortar-stage --only functions,firestore:rules,firestore:indexes,storage",
    "deploy:stage:rules": "firebase deploy --project mortar-stage --only firestore:rules,storage",
    "deploy:stage:functions": "firebase deploy --project mortar-stage --only functions",
    "seed": "node infra/scripts/seed.js",
    "seed:dev:expansion-mock": "npm --prefix infra/scripts run seed:dev:expansion-mock",
    "seed:stage:expansion-mock": "npm --prefix infra/scripts run seed:stage:expansion-mock",
    "export:lesson-4": "npm --prefix tools/course-migration-export run export:lesson-4",
    "export:lesson4-screens": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/lesson4-export-screens/export-lesson4-pptx.ps1 && node tools/lesson4-export-screens/build-manifest.js",
    "seed:lesson4": "node infra/scripts/seed-lesson4-from-pptx.js",
    "update:lesson4": "node tools/lesson4-export-screens/build-manifest.js && node infra/scripts/update-lesson4-from-manifest.js",
    "assign-superadmin": "node infra/scripts/assign-superadmin-roles.js",
    "lint": "npm run lint --workspaces",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:analytics:unit": "npm --prefix functions run test:analytics:unit",
    "test:analytics:integration": "firebase emulators:exec --only functions,auth,firestore --project mortar-dev \"node ./functions/scripts/analytics-callable-integration.mjs\"",
    "test:analytics:phase5": "firebase emulators:exec --only functions,auth,firestore --project mortar-dev \"node ./functions/scripts/phase5-emulator-check.mjs\"",
    "test:analytics:phase6": "firebase emulators:exec --only functions,auth,firestore --project mortar-dev \"node ./functions/scripts/phase6-badge-emulator-check.mjs\"",
    "test:analytics": "npm run test:analytics:unit && npm run test:analytics:integration",
    "test:functions:smoke": "npx -y firebase-tools@latest emulators:exec --only functions,auth,firestore --project mortar-dev \"node ./functions/scripts/functions-emulator-smoke.mjs\"",
    "test:functions:emulator": "npm run test:analytics:unit && npm run test:functions:smoke && npm run test:analytics:integration && npm run test:analytics:phase5 && npm run test:analytics:phase6"
  },
  "devDependencies": {
    "firebase-tools": "^13.0.0",
    "firebase-admin": "^13.6.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
