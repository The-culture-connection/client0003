# Thinkific → MORTAR migration config.
# Copy this file to ".env" (same folder) and fill in your values. ".env" is gitignored.

# ── Thinkific Public API ──────────────────────────────────────────────────────
# Admin → Settings → Code & Analytics → API.
#
# Preferred: API Access Token (Bearer). The subdomain is decoded from the token,
# so THINKIFIC_SUBDOMAIN is optional when this is set.
THINKIFIC_API_TOKEN=your_thinkific_api_access_token_here

# Legacy alternative: API key (used only if THINKIFIC_API_TOKEN is empty).
# THINKIFIC_API_KEY=your_thinkific_api_key_here

# Your school subdomain — the part before ".thinkific.com" in your admin URL.
# Required for the legacy key; optional with a token.
THINKIFIC_SUBDOMAIN=your_subdomain_here

# Session cookie for the internal course-player API (content bodies + quiz/survey
# questions — the public API does NOT expose these). Paste the full Cookie header
# from a logged-in admin browser session. See README → "Capturing a session cookie".
THINKIFIC_COOKIE=

# Optional: the Thinkific course id to migrate (find it via list-thinkific.js).
THINKIFIC_COURSE_ID=

# ── MORTAR / Firebase target ──────────────────────────────────────────────────
# Firestore project to write the new course into. Default: mortar-stage.
FIREBASE_PROJECT_ID=mortar-stage

# Path to the service-account JSON (admin SDK). If unset, setup-course.js looks
# for mortar-stage-firebase-adminsdk-fbsvc-67e746a43d.json at the repo root.
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# Admin uid recorded as the creator of the migrated course/lessons.
MIGRATION_UID=thinkific-migration
