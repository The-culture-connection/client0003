rules_version = '2';

/**
 * Mortar — Firestore security (dev / stage / prod)
 *
 * Deploy: `firebase use staging` (or dev) then `firebase deploy --only firestore:rules`
 *
 * Design notes:
 * - Cloud Functions use Admin SDK and bypass these rules.
 * - Custom claims: assign `roles` array via Admin SDK (e.g. "Admin", "superAdmin").
 * - invite_codes: unauthenticated read is required for the current web /join flow
 *   (query by code before sign-up). This cannot fully prevent enumeration of unused
 *   invites via crafted queries; migrate validation to a callable for stronger security.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function tokenRoles() {
      return ('roles' in request.auth.token && request.auth.token.roles is list)
        ? request.auth.token.roles
        : [];
    }

    /** Admin panel + privileged operations */
    function hasStaffClaim() {
      return isSignedIn()
        && tokenRoles() is list
        && tokenRoles().hasAny(['Admin', 'superAdmin']);
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** `users/{uid}.content_suspended` — staff-only to toggle; blocks new content creates. */
    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function callerContentSuspended() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc(request.auth.uid).data.get('content_suspended', false) == true;
    }

    function callerNotContentSuspended() {
      return isSignedIn() && !callerContentSuspended();
    }

    function ownerContentSuspensionUnchanged() {
      return request.resource.data.get('content_suspended', false)
        == resource.data.get('content_suspended', false);
    }

    function ownerAccountBanUnchanged() {
      return request.resource.data.get('account_banned', false)
        == resource.data.get('account_banned', false);
    }

    /** True if document data grants network admin (Firestore mirror of claims). */
    function dataHasStaffRole(data) {
      return (data.keys().hasAll(['roles'])
          && data.roles is list
          && data.roles.hasAny(['Admin', 'superAdmin']))
        || data.get('role', '') == 'Admin'
        || data.get('role', '') == 'superAdmin';
    }

    /** Block users from granting themselves Admin/superAdmin via client writes. */
    function gainedPrivilegedUserFields() {
      return !dataHasStaffRole(resource.data) && dataHasStaffRole(request.resource.data);
    }

    // --- Expansion roster (server-maintained; admin UI reads) ---
    match /eligibleUsers/{emailDoc} {
      allow read: if hasStaffClaim();
      allow write: if false;
    }

    match /inviteCodes/{inviteId} {
      allow read: if hasStaffClaim();
      allow write: if false;
    }

    match /expansion_cohort_emails/{docId} {
      allow read, write: if hasStaffClaim();
    }

    // --- User profiles ---
    /** Owner cannot self-grant staff, tamper with server counters, or forge earned badges. */
    function userBadgesEarnedUnchanged() {
      let beforeEarned = resource.data.get('badges', {}).get('earned', []);
      let afterEarned = request.resource.data.get('badges', {}).get('earned', []);
      return beforeEarned == afterEarned;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId)
        && !dataHasStaffRole(request.resource.data)
        || hasStaffClaim();
      allow update: if hasStaffClaim()
        || (isOwner(userId) && !gainedPrivilegedUserFields()
          && ownerContentSuspensionUnchanged()
          && ownerAccountBanUnchanged()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['gamification'])
          && userBadgesEarnedUnchanged());
      allow delete: if hasStaffClaim();
    }

    // Staff read is what powers Admin → alumni applications → "View profile"
    // (and its data-room zip export): reviewing an application means reading the
    // applicant's certificates. Writes stay owner-only — staff review this
    // record, they don't author it.
    match /users/{userId}/certificates/{certId} {
      allow read: if isOwner(userId) || hasStaffClaim();
      allow write: if isOwner(userId);
    }

    match /users/{userId}/notifications/{notifId} {
      allow read, write: if isOwner(userId);
    }

    // Same as certificates above: the survey PDFs are the substance of an
    // alumni application, so staff must be able to read them to review one.
    match /users/{userId}/surveyResponses/{docId} {
      allow read: if isOwner(userId) || hasStaffClaim();
      allow write: if isOwner(userId);
    }

    match /users/{userId}/saved_group_threads/{docId} {
      allow read, write: if isOwner(userId);
    }

    // Bookmarked conference sessions (doc id = sessionId).
    match /users/{userId}/saved_sessions/{sessionId} {
      allow read, write: if isOwner(userId);
    }

    // Expansion Network — Cloud Function `runExpansionUserMatching` writes; owner reads matches.
    match /users/{userId}/expansion_matches/{matchUserId} {
      allow read: if isSignedIn() && isOwner(userId);
      allow write: if false;
    }

    // --- Web join (legacy); see file header ---
    match /invite_codes/{docId} {
      allow read: if true;
      allow create, delete: if hasStaffClaim();
      allow update: if isSignedIn()
        && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.used_by == request.auth.uid;
    }

    // --- Community feed (Expansion app + curriculum) ---
    match /user_reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporter_id == request.auth.uid
        && request.resource.data.reported_user_id is string
        && request.resource.data.reported_user_id.size() > 0
        && request.resource.data.reported_user_id != request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 4000
        && request.resource.data.status == 'open';
      allow read: if hasStaffClaim();
      allow update, delete: if hasStaffClaim();
    }

    // --- Beta testing feedback (shake-to-report in the mobile app + the
    // standing widget on Digital Curriculum). Read/triaged by staff in
    // Admin → Beta Testing. Testers file reports but never read the queue,
    // because it contains other testers' screenshots.
    match /beta_feedback/{feedbackId} {
      // Kept to the two checks that are actually security properties: you must
      // be signed in, and you cannot file a report as somebody else. The rest
      // of the payload (screen, source, status) is descriptive metadata the
      // client fills in — validating it here only means a tester's feedback is
      // silently rejected when a field drifts, which is the opposite of what a
      // beta channel is for.
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0
        && request.resource.data.comment.size() <= 4000;
      allow read: if hasStaffClaim();
      // Staff triage only ever changes status / notes; the report itself is
      // the record of what the tester saw and stays as filed.
      allow update: if hasStaffClaim()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'admin_note', 'updated_at', 'resolved_at', 'resolved_by']);
      allow delete: if hasStaffClaim();
    }

    // --- Remote switches read by the apps at startup (e.g. `beta_feedback`
    // turning shake-to-report off once beta ends, without a store release).
    match /app_config/{configId} {
      allow read: if isSignedIn();
      allow write: if hasStaffClaim();
    }

    match /feed_posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && callerNotContentSuspended()
        && request.resource.data.author_id == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.author_id == request.auth.uid;
    }

    match /feed_posts/{postId}/likes/{likerId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == likerId;
    }

    match /feed_posts/{postId}/replies/{replyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && callerNotContentSuspended()
        && request.resource.data.author_id == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.author_id == request.auth.uid;
    }

    match /feed_posts/{postId}/replies/{replyId}/likes/{likerId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == likerId;
    }

    // --- Events: Digital Curriculum (`events`) + Expansion mobile (`events_mobile`) ---
    function eventReadableByMember() {
      return isSignedIn() && (
        hasStaffClaim()
        || !(resource.data.keys().hasAll(['approval_status']))
        || resource.data.get('approval_status', 'approved') == 'approved'
        || (resource.data.keys().hasAll(['created_by'])
            && resource.data.created_by == request.auth.uid)
      );
    }

    function eventPublishedForRsvp() {
      return !(resource.data.keys().hasAll(['approval_status']))
        || resource.data.get('approval_status', 'approved') == 'approved';
    }

    function staffCurriculumEventKeys() {
      return [
        'title', 'date', 'time', 'location', 'details', 'event_type', 'image_url',
        'registered_users', 'created_at', 'updated_at', 'total_spots', 'available_spots', 'distribution'
      ];
    }

    function staffCurriculumEventCreate() {
      return request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 500
        && request.resource.data.time is string
        && request.resource.data.location is string
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 20000
        && request.resource.data.registered_users is list
        && request.resource.data.registered_users.size() == 0
        && (!request.resource.data.keys().hasAny(['event_type'])
            || request.resource.data.event_type in ['Online', 'In-person'])
        && (!request.resource.data.keys().hasAny(['distribution'])
            || request.resource.data.distribution in ['curriculum', 'both'])
        && request.resource.data.keys().hasOnly(staffCurriculumEventKeys());
    }

    function staffMobilePublishedEventCreate() {
      return request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 500
        && request.resource.data.time is string
        && request.resource.data.location is string
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 20000
        && request.resource.data.registered_users is list
        && request.resource.data.registered_users.size() == 0
        && (!request.resource.data.keys().hasAny(['event_type'])
            || request.resource.data.event_type in ['Online', 'In-person'])
        && (!request.resource.data.keys().hasAny(['distribution'])
            || request.resource.data.distribution in ['mobile', 'both'])
        && (!request.resource.data.keys().hasAny(['approval_status']))
        && request.resource.data.keys().hasOnly(staffCurriculumEventKeys());
    }

    function memberSubmittedMobileEventCreate() {
      return callerNotContentSuspended()
        && request.resource.data.approval_status == 'pending'
        && request.resource.data.created_by == request.auth.uid
        && request.resource.data.registered_users is list
        && request.resource.data.registered_users.size() == 0
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 500
        && request.resource.data.time is string
        && request.resource.data.location is string
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 20000
        && (!request.resource.data.keys().hasAny(['event_type'])
            || request.resource.data.event_type in ['Online', 'In-person'])
        && request.resource.data.keys().hasOnly([
          'title', 'date', 'time', 'location', 'details', 'event_type', 'image_url',
          'registered_users', 'approval_status', 'created_by', 'created_at', 'updated_at',
          'total_spots', 'available_spots'
        ]);
    }

    match /events/{eventId} {
      allow read: if eventReadableByMember();
      allow create: if isSignedIn() && hasStaffClaim() && staffCurriculumEventCreate();
      allow delete: if hasStaffClaim();
      allow update: if hasStaffClaim()
        || (isSignedIn()
          && eventPublishedForRsvp()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['registered_users', 'updated_at', 'available_spots']));
    }

    // Conference App (Phase 1): read-only for any signed-in user so the Mortarverse
    // chooser and Conference screens can render. Write access (create/update conferences,
    // ticket-based access) is server-only via callables from Phase 2 onward.
    match /conferences/{conferenceId} {
      allow read: if isSignedIn();
      allow write: if hasStaffClaim();

      match /sessions/{sessionId} {
        allow read: if isSignedIn();
        allow create, delete: if hasStaffClaim();
        // Attendees may RSVP: toggle only their own membership in registered_users
        // (key allowlist mirrors the events RSVP rule).
        allow update: if hasStaffClaim()
          || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['registered_users', 'updated_at']));

        // Per-session chat room — any signed-in attendee can read/post; messages
        // are author-scoped and immutable.
        match /messages/{msgId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn()
            && callerNotContentSuspended()
            && request.resource.data.sender_id == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 10000
            && request.resource.data.keys().hasOnly(['sender_id', 'author_name', 'text', 'created_at']);
          allow update, delete: if false;
        }
      }

      // Community Hub — an open forum for the conference. Any signed-in
      // attendee may post and reply; authors may delete their own content.
      //
      // `reply_count` is denormalised onto the post so the feed does not need a
      // listener per row, which means anyone posting a reply must be able to
      // bump that one field on someone else's post — hence the narrow update
      // allowance below (author-only for everything else).
      match /community_posts/{postId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && callerNotContentSuspended()
          && request.resource.data.author_id == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 5000
          && request.resource.data.reply_count == 0
          && (!('tag' in request.resource.data)
            || (request.resource.data.tag is string
              && request.resource.data.tag.size() > 0
              && request.resource.data.tag.size() <= 24))
          && request.resource.data.keys().hasOnly([
              'author_id', 'author_name', 'author_subtitle', 'body', 'tag',
              'reply_count', 'created_at']);
        allow delete: if isSignedIn() && resource.data.author_id == request.auth.uid;
        allow update: if isSignedIn()
          && (
            // The author editing nothing but their own message body.
            (resource.data.author_id == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['body', 'updated_at']))
            // Or anyone moving the reply counter by exactly one, in step with
            // adding or removing a reply.
            || (callerNotContentSuspended()
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['reply_count'])
              && request.resource.data.reply_count >= 0
              && (request.resource.data.reply_count == resource.data.reply_count + 1
                || request.resource.data.reply_count == resource.data.reply_count - 1))
          );

        match /replies/{replyId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn()
            && callerNotContentSuspended()
            && request.resource.data.author_id == request.auth.uid
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 5000
            && request.resource.data.keys().hasOnly(
                ['author_id', 'author_name', 'author_subtitle', 'body', 'created_at']);
          allow update: if false;
          // The reply's own author, or the author of the post it sits under
          // (so deleting a message can clear the thread beneath it).
          allow delete: if isSignedIn()
            && (
              resource.data.author_id == request.auth.uid
              || get(/databases/$(database)/documents/conferences/$(conferenceId)/community_posts/$(postId))
                  .data.author_id == request.auth.uid
            );
        }
      }

      // Sponsor booths (admin-managed; read by any signed-in attendee).
      match /sponsors/{sponsorId} {
        allow read: if isSignedIn();
        allow write: if hasStaffClaim();
      }

      // Venue floor plans + embedded room pins (admin-managed; read by attendees).
      match /floors/{floorId} {
        allow read: if isSignedIn();
        allow write: if hasStaffClaim();
      }

      // Ticket-auth (Phase A): buyer roster and codes are server-only (written by
      // callables via the Admin SDK, which bypasses rules). Never client-readable —
      // codes are plaintext. Staff read allowed for the admin codes view.
      match /ticketBuyers/{buyerEmail} {
        allow read: if hasStaffClaim();
        allow write: if false;
      }
      match /ticketCodes/{ticketCodeId} {
        allow read: if hasStaffClaim();
        allow write: if false;
      }

      // Attendee access record (server-written on redemption). A user may read
      // their own record so the app can gate entry; staff may read all.
      match /attendees/{uid} {
        allow read: if isSignedIn() && (request.auth.uid == uid || hasStaffClaim());
        allow write: if false;
      }

      // Daily check-in counters (server-written via the checkInToConference
      // callable). Staff read for the admin dashboard; per-user check-in state
      // lives on the attendees/{uid} doc above.
      match /checkinDays/{dateKey} {
        allow read: if hasStaffClaim();
        allow write: if false;
      }

      // Networking zone: discoverable attendee snapshots (server-written via the
      // networking callables). Any signed-in attendee can read the deck; a user's
      // swipes are readable only by that user (this is the mutual-match secret).
      match /networkingProfiles/{uid} {
        allow read: if isSignedIn();
        allow write: if false;
        match /swipes/{targetUid} {
          allow read: if isSignedIn() && request.auth.uid == uid;
          allow write: if false;
        }
      }

      // Mutual matches (server-written on a reciprocal like). Only the two
      // participants may read their own match.
      match /matches/{pairId} {
        allow read: if isSignedIn() && request.auth.uid in resource.data.users;
        allow write: if false;
      }
    }

    match /events_mobile/{eventId} {
      allow read: if eventReadableByMember();
      allow create: if isSignedIn()
        && (memberSubmittedMobileEventCreate()
          || (hasStaffClaim() && staffMobilePublishedEventCreate()));
      allow delete: if hasStaffClaim();
      allow update: if hasStaffClaim()
        || (isSignedIn()
          && eventPublishedForRsvp()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['registered_users', 'updated_at', 'available_spots']));
    }

    // --- Mortar Info (staff announcements for Expansion home) ---
    function mortarInfoPostKeys() {
      return [
        'title', 'body', 'published', 'media', 'created_at', 'updated_at',
        'newsletter_url', 'newsletter_label'
      ];
    }

    function staffMortarInfoWrite() {
      return request.resource.data.keys().hasOnly(mortarInfoPostKeys())
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 300
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 20000
        && (request.resource.data.title.size() > 0 || request.resource.data.body.size() > 0)
        && request.resource.data.published is bool
        && request.resource.data.media is list
        && request.resource.data.media.size() <= 30
        && (!('newsletter_url' in request.resource.data)
          || (request.resource.data.newsletter_url is string
            && request.resource.data.newsletter_url.size() <= 2048
            && (request.resource.data.newsletter_url.size() == 0
              || request.resource.data.newsletter_url.matches('https://.*'))))
        && (!('newsletter_label' in request.resource.data)
          || (request.resource.data.newsletter_label is string
            && request.resource.data.newsletter_label.size() <= 200));
    }

    match /mortar_info_posts/{postId} {
      allow read: if isSignedIn() && (
        resource.data.get('published', false) == true
        || hasStaffClaim()
      );
      allow create: if hasStaffClaim() && staffMortarInfoWrite();
      allow update: if hasStaffClaim() && staffMortarInfoWrite();
      allow delete: if hasStaffClaim();
    }

    // --- Expansion app: jobs & skills listings (Explore) ---
    match /expansion_jobs/{jobId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && callerNotContentSuspended()
        && request.resource.data.author_id == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 300
        && request.resource.data.industry is string
        && request.resource.data.industry.size() > 0
        && request.resource.data.industry.size() <= 120
        && request.resource.data.location is string
        && request.resource.data.location.size() > 0
        && request.resource.data.location.size() <= 200
        && request.resource.data.location_mode in ['remote', 'in_person']
        && request.resource.data.skill_seeking is list
        && request.resource.data.skill_seeking.size() >= 1
        && request.resource.data.skill_seeking.size() <= 30
        && request.resource.data.keys().hasOnly([
          'title', 'skill_seeking', 'company', 'location', 'description', 'industry', 'location_mode',
          'author_id', 'author_name', 'created_at', 'updated_at'
        ]);
      allow update, delete: if hasStaffClaim()
        || (isSignedIn()
          && resource.data.author_id == request.auth.uid
          && request.resource.data.author_id == resource.data.author_id);
    }

    match /expansion_skills/{skillId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && callerNotContentSuspended()
        && request.resource.data.author_id == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 300
        && request.resource.data.industry is string
        && request.resource.data.industry.size() > 0
        && request.resource.data.industry.size() <= 120
        && request.resource.data.location is string
        && request.resource.data.location.size() > 0
        && request.resource.data.location.size() <= 200
        && request.resource.data.location_mode in ['remote', 'in_person']
        && request.resource.data.skill_offering is list
        && request.resource.data.skill_offering.size() >= 1
        && request.resource.data.skill_offering.size() <= 30
        && request.resource.data.keys().hasOnly([
          'title', 'skill_offering', 'summary', 'location', 'industry', 'location_mode',
          'author_id', 'author_name', 'created_at', 'updated_at'
        ]);
      allow update, delete: if hasStaffClaim()
        || (isSignedIn()
          && resource.data.author_id == request.auth.uid
          && request.resource.data.author_id == resource.data.author_id);
    }

    // --- Direct messages (1:1 threads) ---
    // Thread id is the two participant uids joined by '_' in sorted order ("a_b"), so the
    // caller is a participant iff their uid is the prefix ("uid_…") or suffix ("…_uid").
    // Deriving this from the id (instead of get()-ing the thread doc) lets the first message
    // of a brand-new conversation be created in the SAME batch as the thread, and lets an
    // empty conversation be opened — while still exposing the thread only to its two uids.
    // (Firebase uids carry no regex metacharacters; seed uids add only '_', which is safe.)
    function dmCallerInThreadId(threadId) {
      return isSignedIn()
        && (threadId.matches(request.auth.uid + '_.*')
          || threadId.matches('.*_' + request.auth.uid));
    }

    match /dm_threads/{threadId} {
      // `get` and `list` need genuinely different rules, not one combined `allow read` —
      // Firestore's list-query validator rejects a query unless the rule matches the query's
      // own filter, and OR-ing that check with the id-pattern check (still needed for a `get()`
      // on a not-yet-created thread, where `resource` is null) was not enough to satisfy it in
      // practice, even though the id-pattern is true for every result by construction.
      //
      // `get`: threadRef.get() runs before the first message is sent, when the thread may not
      // exist yet (resource == null) — the id-pattern check needs no resource.data access, so it
      // works for both existing and not-yet-created threads.
      allow get: if dmCallerInThreadId(threadId);
      // `list`: watchMyThreadDocs()'s `where('participant_ids', arrayContains: uid)` query — must
      // reference the exact field the query filters on for Firestore to statically prove it safe.
      // Confirmed against the Firestore emulator (@firebase/rules-unit-testing): adding an
      // `is list` type-guard here — even harmlessly `&&`-ed in — breaks that provability check
      // and the query is rejected outright, so this intentionally has no type guard.
      allow list: if request.auth.uid in resource.data.participant_ids;
      allow create: if isSignedIn()
        && callerNotContentSuspended()
        && request.resource.data.participant_ids is list
        && request.resource.data.participant_ids.size() == 2
        && request.auth.uid in request.resource.data.participant_ids
        && request.resource.data.participant_ids[0] is string
        && request.resource.data.participant_ids[1] is string
        && request.resource.data.participant_ids[0]
          < request.resource.data.participant_ids[1]
        && threadId == request.resource.data.participant_ids[0] + '_'
          + request.resource.data.participant_ids[1]
        && request.resource.data.keys().hasOnly([
          'participant_ids', 'created_at', 'updated_at', 'last_preview', 'last_sender_id'
        ]);
      allow update: if isSignedIn()
        && resource.data.participant_ids is list
        && request.auth.uid in resource.data.participant_ids
        && request.resource.data.participant_ids == resource.data.participant_ids
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['updated_at', 'last_preview', 'last_sender_id', 'last_read']);
      allow delete: if false;
    }

    match /dm_threads/{threadId}/messages/{msgId} {
      allow read: if dmCallerInThreadId(threadId);
      allow create: if dmCallerInThreadId(threadId)
        && callerNotContentSuspended()
        && request.resource.data.sender_id == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 10000
        && request.resource.data.keys().hasOnly([
          'sender_id', 'text', 'created_at', 'attachment_type', 'attachment_id'
        ])
        && (!request.resource.data.keys().hasAll(['attachment_type'])
          || (request.resource.data.attachment_type in ['job', 'skill', 'event']
            && request.resource.data.keys().hasAll(['attachment_id'])
            && request.resource.data.attachment_id is string
            && request.resource.data.attachment_id.size() > 0));
      // The message itself stays immutable — the single exception is the
      // `reactions` map (uid → emoji), which either participant may write.
      //
      // A map field is written whole, so "you can edit reactions" would
      // otherwise let one participant overwrite or delete the other's. The
      // second diff pins the write down to the caller's own key: everyone
      // else's reaction has to survive the update byte-for-byte. Removing a
      // reaction deletes that key, which `affectedKeys()` covers too.
      allow update: if dmCallerInThreadId(threadId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        && request.resource.data.get('reactions', {})
             .diff(resource.data.get('reactions', {}))
             .affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in request.resource.data.get('reactions', {}))
          || (request.resource.data.reactions[request.auth.uid] is string
            && request.resource.data.reactions[request.auth.uid].size() > 0
            && request.resource.data.reactions[request.auth.uid].size() <= 16));
      allow delete: if false;
    }

    // --- Curriculum structure ---
    match /curricula/{document=**} {
      allow read: if isSignedIn();
      allow write: if hasStaffClaim();
    }

    match /courses/{document=**} {
      allow read: if isSignedIn();
      allow write: if hasStaffClaim();
    }

    match /courseProgress/{docId} {
      // resource is null for a get() on a not-yet-created progress doc — allow it
      // (returns an empty snapshot, leaks nothing) so new learners can open a
      // course before they have any progress. Existing docs still require ownership.
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // --- Groups (member changes via joinGroup / leaveGroup callables only) ---
    match /Groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if hasStaffClaim();
      allow update: if hasStaffClaim();
      allow delete: if hasStaffClaim();
    }

    function groupDoc(groupId) {
      return get(/databases/$(database)/documents/Groups/$(groupId));
    }

    function isGroupMember(groupId) {
      return groupDoc(groupId).exists
        && groupDoc(groupId).data.keys().hasAll(['GroupMembers'])
        && groupDoc(groupId).data.GroupMembers is list
        && request.auth.uid in groupDoc(groupId).data.GroupMembers;
    }

    match /Groups/{groupId}/Messages/{msgId} {
      // Digital Curriculum group chat: any signed-in (non-suspended) user may
      // read and send messages — group membership is handled in the app UI,
      // and the rules-level GroupMembers check was rejecting legitimate
      // students with "insufficient permissions". Senders still cannot post
      // as anyone but themselves, and only staff can edit/delete.
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && callerNotContentSuspended()
        && request.resource.data.Senderid == request.auth.uid;
      allow update, delete: if hasStaffClaim();
    }

    function groupThreadAuthorUpdateKeys() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['body', 'title', 'updated_at']);
    }

    match /Groups/{groupId}/threads/{threadId} {
      allow read: if isSignedIn() && (hasStaffClaim() || isGroupMember(groupId));
      allow create: if isSignedIn() && isGroupMember(groupId)
        && request.resource.data.author_id == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 20000
        && request.resource.data.author_name is string;
      allow update: if hasStaffClaim()
        || (isSignedIn() && isGroupMember(groupId)
          && resource.data.author_id == request.auth.uid
          && groupThreadAuthorUpdateKeys());
      allow delete: if hasStaffClaim()
        || (isSignedIn() && isGroupMember(groupId)
          && resource.data.author_id == request.auth.uid);
    }

    match /Groups/{groupId}/threads/{threadId}/comments/{commentId} {
      allow read: if isSignedIn() && (hasStaffClaim() || isGroupMember(groupId));
      allow create: if isSignedIn() && isGroupMember(groupId)
        && request.resource.data.author_id == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 10000
        && request.resource.data.author_name is string;
      allow update: if hasStaffClaim()
        || (isSignedIn() && isGroupMember(groupId)
          && resource.data.author_id == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['body', 'updated_at']));
      allow delete: if hasStaffClaim()
        || (isSignedIn() && isGroupMember(groupId)
          && resource.data.author_id == request.auth.uid);
    }

    function voteValueOk() {
      return request.resource.data.keys().hasOnly(['value', 'updated_at'])
        && request.resource.data.value is int
        && (request.resource.data.value == 1 || request.resource.data.value == -1);
    }

    match /Groups/{groupId}/threads/{threadId}/votes/{voterId} {
      allow read: if isSignedIn() && (hasStaffClaim() || isGroupMember(groupId));
      allow create, update: if isSignedIn() && isGroupMember(groupId)
        && request.auth.uid == voterId
        && voteValueOk();
      allow delete: if isSignedIn() && isGroupMember(groupId) && request.auth.uid == voterId;
    }

    match /Groups/{groupId}/threads/{threadId}/comments/{commentId}/votes/{voterId} {
      allow read: if isSignedIn() && (hasStaffClaim() || isGroupMember(groupId));
      allow create, update: if isSignedIn() && isGroupMember(groupId)
        && request.auth.uid == voterId
        && voteValueOk();
      allow delete: if isSignedIn() && isGroupMember(groupId) && request.auth.uid == voterId;
    }

    // --- Mobile-only groups (Expansion app); threads mirror `Groups` ---
    /** Optional `category` on `groups_mobile` — must match app allowlist when present. */
    function mobileGroupCategoryOk() {
      return !request.resource.data.keys().hasAny(['category'])
        || (request.resource.data.category is string
          && (request.resource.data.category == ''
            || request.resource.data.category in [
              'Business & Entrepreneurship',
              'Marketing & Brand Growth',
              'Money, Funding & Resources',
              'Operations & Logistics',
              'Community & Networking',
              'Events & Opportunities',
              'Industry-Specific',
              'Wins, Lessons & Advice'
            ]));
    }

    match /groups_mobile/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && callerNotContentSuspended()
        && request.resource.data.Name is string
        && request.resource.data.Name.size() > 0
        && request.resource.data.Name.size() <= 120
        && request.resource.data.Status in ['Open', 'Closed']
        && request.resource.data.GroupMembers is list
        && request.auth.uid in request.resource.data.GroupMembers
        && request.resource.data.PendingMembers is list
        && request.resource.data.createdBy == request.auth.uid
        && !request.resource.data.keys().hasAny(['isFeatured', 'featuredRank'])
        && (!('memberCount' in request.resource.data) || request.resource.data.memberCount == 1)
        && (!('threadCount' in request.resource.data) || request.resource.data.threadCount == 0)
        && mobileGroupCategoryOk();
      allow update: if mobileGroupCategoryOk()
        && (hasStaffClaim()
        || (isSignedIn() && resource.data.get('createdBy', '') == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'GroupMembers', 'PendingMembers', 'memberCount', 'threadCount', 'isFeatured', 'featuredRank'
          ])));
      allow delete: if hasStaffClaim()
        || (isSignedIn() && resource.data.get('createdBy', '') == request.auth.uid);
    }

    // Communities are universal: any signed-in user may read and participate, regardless of
    // role or group membership. Authorship is still enforced (you can only edit/delete your
    // own content / vote as yourself) and content is validated; staff is a non-denying override.
    match /groups_mobile/{groupId}/threads/{threadId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && callerNotContentSuspended()
        && request.resource.data.author_id == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 20000
        && request.resource.data.author_name is string;
      allow update: if hasStaffClaim()
        || (isSignedIn()
          && resource.data.author_id == request.auth.uid
          && groupThreadAuthorUpdateKeys());
      allow delete: if hasStaffClaim()
        || (isSignedIn() && resource.data.author_id == request.auth.uid);
    }

    match /groups_mobile/{groupId}/threads/{threadId}/comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && callerNotContentSuspended()
        && request.resource.data.author_id == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 10000
        && request.resource.data.author_name is string;
      allow update: if hasStaffClaim()
        || (isSignedIn()
          && resource.data.author_id == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['body', 'updated_at']));
      allow delete: if hasStaffClaim()
        || (isSignedIn() && resource.data.author_id == request.auth.uid);
    }

    match /groups_mobile/{groupId}/threads/{threadId}/votes/{voterId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == voterId && voteValueOk();
      allow delete: if isSignedIn() && request.auth.uid == voterId;
    }

    match /groups_mobile/{groupId}/threads/{threadId}/comments/{commentId}/votes/{voterId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == voterId && voteValueOk();
      allow delete: if isSignedIn() && request.auth.uid == voterId;
    }

    match /badge_definitions/{badgeId} {
      allow read: if isSignedIn();
      allow write: if hasStaffClaim();
    }

    // Staff-curated images for badge definitions (Digital Curriculum Admin → Badge bank)
    match /badge_bank/{assetId} {
      allow read: if isSignedIn();
      allow create, update, delete: if hasStaffClaim();
    }

    match /achievement_events/{eventId} {
      allow read: if hasStaffClaim();
      allow write: if false;
    }

    // --- DMs (student thread + admin replies). Collection id contains spaces — URL-encode in rules paths. ---
    match /Digital%20Student%20DMs/{dmId} {
      allow read: if isSignedIn()
        && (resource.data.uid == request.auth.uid || hasStaffClaim());
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if hasStaffClaim();
    }

    match /Digital%20Student%20DMs/{dmId}/replies/{replyId} {
      allow read: if isSignedIn()
        && (get(/databases/$(database)/documents/Digital%20Student%20DMs/$(dmId)).data.uid == request.auth.uid
          || hasStaffClaim());
      allow create, update, delete: if hasStaffClaim();
    }

    // --- Graduation applications ---
    match /GraduationApplications/{appId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || hasStaffClaim());
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if hasStaffClaim();
    }

    // --- Shop catalog (browse may be unauthenticated; stock updates from signed-in shoppers) ---
    match /shopItems/{itemId} {
      allow read: if true;
      allow create, delete: if hasStaffClaim();
      allow update: if hasStaffClaim()
        || (isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['sizeStocks', 'stockQuantity', 'updatedAt']));
    }

    match /shop_orders/{orderId} {
      allow read: if hasStaffClaim()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /payment_orders/{orderId} {
      allow read: if hasStaffClaim()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // --- Curriculum web discussion threads (Digital Curriculum) ---
    match /discussion_threads/{threadId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && callerNotContentSuspended()
        && request.resource.data.author_uid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.content is string
        && request.resource.data.category is string;
      allow update: if isSignedIn() && (
        hasStaffClaim()
        || (
          resource.data.author_uid == request.auth.uid
          && request.resource.data.author_uid == resource.data.author_uid
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['view_count', 'updated_at'])
          && request.resource.data.view_count is int
          && request.resource.data.view_count >= resource.data.get('view_count', 0)
          && request.resource.data.view_count <= resource.data.get('view_count', 0) + 5
        )
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes_count', 'updated_at']))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updated_at']))
      );
      allow delete: if hasStaffClaim()
        || (isSignedIn() && resource.data.author_uid == request.auth.uid);
    }

    match /discussion_threads/{threadId}/replies/{replyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && callerNotContentSuspended()
        && request.resource.data.author_uid == request.auth.uid
        && request.resource.data.content is string
        && (!('parent_reply_id' in request.resource.data)
          || request.resource.data.parent_reply_id == null
          || request.resource.data.parent_reply_id is string);
      allow update: if isSignedIn() && (
        hasStaffClaim()
        || (
          resource.data.author_uid == request.auth.uid
          && request.resource.data.author_uid == resource.data.author_uid
        )
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes_count', 'updated_at']))
      );
      allow delete: if hasStaffClaim()
        || (isSignedIn() && resource.data.author_uid == request.auth.uid);
    }

    match /discussion_threads/{threadId}/thread_likes/{likerId} {
      allow read: if isSignedIn();
      allow create, delete: if isSignedIn() && request.auth.uid == likerId;
    }

    match /discussion_threads/{threadId}/replies/{replyId}/reply_likes/{likerId} {
      allow read: if isSignedIn();
      allow create, delete: if isSignedIn() && request.auth.uid == likerId;
    }

    // Chapter quizzes (metadata readable; variants scored only via Cloud Functions)
    match /quizzes/{quizId} {
      allow read: if isSignedIn();
      allow write: if hasStaffClaim();
    }

    match /quizzes/{quizId}/variants/{variantId} {
      allow read: if false;
      allow write: if hasStaffClaim();
    }

    match /quiz_attempts/{attemptId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow write: if false;
    }

    match /meeting_proposals/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if hasStaffClaim();
    }

    match /certificates/{docId} {
      allow read: if isSignedIn();
      allow write: if hasStaffClaim();
    }

    // Public, branded certificate share pages.
    match /certificate_public_links/{shareId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    // --- Canonical analytics (Admin SDK + validated callables only) ---
    match /analytics_raw_events/{id} {
      allow read, write: if false;
    }

    match /analytics_daily_summaries/{id} {
      allow read: if hasStaffClaim();
      allow write: if false;
    }

    match /analytics_user_badges/{userId} {
      allow read: if isOwner(userId) || hasStaffClaim();
      allow write: if false;
    }

    // Phase 4 summaries (Admin SDK + triggers only)
    match /user_analytics_summary/{userId} {
      allow read: if isOwner(userId) || hasStaffClaim();
      allow write: if false;
    }

    match /daily_metrics/{dateId} {
      allow read: if hasStaffClaim();
      allow write: if false;
    }

    match /derived_metrics/{dateId} {
      allow read: if hasStaffClaim();
      allow write: if false;
    }

    match /course_analytics_summary/{courseId} {
      allow read: if hasStaffClaim();
      allow write: if false;
    }

    match /community_analytics_summary/{docId} {
      allow read: if hasStaffClaim();
      allow write: if false;
    }

    // Expansion mobile raw analytics (Flutter client → Firestore)
    match /expansion_analytics_events/{eventId} {
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.event_name is string
        && request.resource.data.session_id is string;
      allow read: if hasStaffClaim();
      allow update, delete: if false;
    }

    // Phase 4 — Expansion mobile summaries (Cloud Functions triggers only)
    match /community_summary/{groupId} {
      allow read: if hasStaffClaim();
      allow write: if false;
    }

    match /matching_summary/{userId} {
      allow read: if hasStaffClaim();
      allow write: if false;
    }

    match /job_summary/{jobId} {
      allow read: if hasStaffClaim();
      allow write: if false;
    }

    match /funnel_summary/{funnelId} {
      allow read: if hasStaffClaim();
      allow write: if false;
    }

    match /friction_summary/{eventName} {
      allow read: if hasStaffClaim();
      allow write: if false;
    }

    // Phase 6 — analytics badges (Functions writes only)
    match /user_badges/{userId} {
      allow read: if isOwner(userId) || hasStaffClaim();
      allow write: if false;

      match /awarded/{badgeId} {
        allow read: if isOwner(userId) || hasStaffClaim();
        allow write: if false;
      }
    }

    match /badge_progress/{userId} {
      allow read: if isOwner(userId) || hasStaffClaim();
      allow write: if false;
    }

    // --- Conference missions (admin-authored challenges) ---
    // Definitions are readable by any signed-in attendee so the lobby can render
    // them; only staff author them. Evaluation and awards are Functions-only.
    match /conference_missions/{missionId} {
      allow read: if isSignedIn();
      allow write: if hasStaffClaim();
    }

    // Per-user mission progress, written by the mission evaluator (Admin SDK).
    match /mission_progress/{userId} {
      allow read: if isOwner(userId) || hasStaffClaim();
      allow write: if false;
    }

    // --- Survey / Implicit Feedback Layer ---
    match /survey_responses/{docId} {
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow read: if hasStaffClaim();
      allow update, delete: if false;
    }

    match /survey_templates/{docId} {
      allow read: if isSignedIn();
      allow write: if hasStaffClaim();
    }

    match /survey_triggers/{docId} {
      allow read: if isSignedIn();
      allow write: if hasStaffClaim();
    }

    match /survey_summaries/{docId} {
      allow read, write: if hasStaffClaim();
    }

    // --- Course review notes (admin-only, slide-anchored notes in the lesson player) ---
    // Written by the AdminReviewNotesPanel in the Digital Curriculum web app.
    match /course_review_notes/{noteId} {
      allow read: if hasStaffClaim();
      allow create: if hasStaffClaim()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.courseId is string
        && request.resource.data.courseId.size() > 0
        && request.resource.data.lessonId is string
        && request.resource.data.lessonId.size() > 0
        && request.resource.data.courseLessonKey
          == request.resource.data.courseId + '__' + request.resource.data.lessonId
        && request.resource.data.slideIndex is int
        && request.resource.data.slideIndex >= 0
        && request.resource.data.note is string
        && request.resource.data.note.size() > 0
        && request.resource.data.note.size() <= 5000
        && request.resource.data.authorName is string
        && request.resource.data.resolved == false
        && request.resource.data.keys().hasOnly([
          'courseLessonKey', 'courseId', 'lessonId', 'slideIndex', 'note',
          'authorUid', 'authorName', 'resolved', 'resolvedBy', 'resolvedAt', 'createdAt'
        ]);
      allow update: if hasStaffClaim()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['resolved', 'resolvedBy', 'resolvedAt', 'note']);
      allow delete: if hasStaffClaim();
    }

    // Account & data deletion requests (Google Play compliance).
    // Written only by the submitAccountDeletionRequest callable via the Admin
    // SDK, which bypasses rules — a public client create would let anyone forge
    // requests against another person's address. Staff read them to action the
    // deletion, and may update status/notes but never create or delete.
    match /account_deletion_requests/{requestId} {
      allow read: if hasStaffClaim();
      allow update: if hasStaffClaim()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'staff_notes', 'handled_at', 'handled_by_uid']);
      allow create, delete: if false;
    }

    // --- Deny everything else ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
