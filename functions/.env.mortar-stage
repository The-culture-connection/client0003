# Runtime env for Cloud Functions in project `mortar-stage`.
# The Firebase CLI loads `.env` + `.env.<project-id>` from this directory at deploy
# time, so a value here ships with `firebase deploy --only functions --project stage`.
#
# Secrets do NOT belong here — STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, BREVO_API_KEY,
# OPEN_AI_KEY and HUBSPOT_PRIVATE_APP_TOKEN are `defineSecret` params in Secret Manager
# (`firebase functions:secrets:set …`) and are unaffected by this file.

# Base URL for transactional email links (functions/src/email/emailConfig.ts) and for
# Stripe success/cancel redirects when the caller doesn't send its own
# (functions/src/callables/createStripeCheckoutSession.ts).
DIGITAL_CURRICULUM_PLATFORM_URL=https://www.mortarmastersonline.com
