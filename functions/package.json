{
  "name": "mortar-functions",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "test:analytics:unit": "npm run build && node ./scripts/verify-analytics-phase.mjs",
    "verify:analytics": "npm run test:analytics:unit",
    "lint": "node -e \"require('fs').existsSync('lib')||process.exit(0)\" && tsc --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5",
    "jszip": "^3.10.1",
    "stripe": "^18.5.0",
    "xml2js": "^0.6.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/xml2js": "^0.4.14",
    "eslint": "^8.57.0",
    "typescript": "^5.5.0"
  }
}
