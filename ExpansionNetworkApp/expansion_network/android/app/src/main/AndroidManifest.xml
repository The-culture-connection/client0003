<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Scanning a member's card QR (mobile_scanner / CameraX). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Sustained buzz under the Mortarverse welcome animation. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The scanner is a convenience, not a requirement: keep the app installable
         on camera-less devices, where MobileScannerErrorCode.unsupported is shown. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Photo and Video Permissions policy: every image pick is a one-off, user-initiated
         `pickImage(source: ImageSource.gallery)` routed through the Android Photo Picker
         (see configureImagePicker() in lib/main.dart), which needs no permission at all.
         These stay declared with tools:node="remove" so a future dependency cannot merge
         them back in unnoticed and get the release rejected again. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <application
        android:label="MORTAR Alumni Network"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Android App Links: https://<host>/tickets, the URL behind the
                 conference ticket QR codes. `autoVerify` makes Android fetch
                 /.well-known/assetlinks.json from the host at install time and,
                 if this app's signing fingerprint is listed there, open the
                 link directly instead of showing a chooser — which is the whole
                 point: a scanned QR should land in the app, not in Chrome.

                 VERIFICATION IS NOT LIVE until assetlinks.json on the host
                 lists the release signing cert's SHA-256 fingerprint (see
                 `Digital Curriculum/public/.well-known/assetlinks.json`). Until
                 then the link still works — Android just offers a chooser
                 rather than going straight in.

                 Host must match `AppLinks.digitalCurriculum` in
                 lib/constants/app_links.dart and the `_claimedHosts` set in
                 lib/services/deep_link_resolver.dart. Change one, change all
                 three. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                      android:host="mortar-stage-stage.up.railway.app"
                      android:pathPrefix="/tickets" />
            </intent-filter>
            <!-- Custom scheme, already registered on iOS as CFBundleURLSchemes.
                 Kept as the belt-and-braces path: it needs no host verification,
                 so `mortaralumni://tickets` works on a device where App Link
                 verification has not completed (or the host has changed). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mortaralumni" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Package visibility: required for url_launcher (https/http VIEW) on API 30+ -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <!-- Package visibility: calendar app for add_2_calendar INSERT (API 30+) -->
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.item/event" />
        </intent>
    </queries>
</manifest>
